{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start WhatChat Backend",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/start-backend.ps1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Start WhatChat Frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Backend Tests",
			"type": "shell",
			"command": "mvn",
			"args": [
				"test",
				"-f",
				"backend/pom.xml"
			],
			"problemMatcher": [],
			"group": "test"
		}
	]
}