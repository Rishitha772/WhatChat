# Frontend URL and allowed browser origin
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# Backend session signing secret: generate at least 32 random bytes
JWT_SECRET=
COOKIE_SECURE=false

# ==============================================================================
# MongoDB Database (Chats, Messages, Contacts & My Space Memory Storage)
# ==============================================================================
# Option 1: Local MongoDB (default)
MONGODB_URI=mongodb+srv://rishitha_whatchat_db_user:Rishu%401108@cluster0.skuwmba.mongodb.net/whatchat_db?retryWrites=true&w=majority
MONGODB_DATABASE=whatchat_db

# Option 2: MongoDB Atlas Cloud (Free tier)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/whatchat_db?retryWrites=true&w=majority

# ==============================================================================
# Relational Database (Auth Accounts & Session Security)
# By default, WhatChat runs standalone with embedded H2 (zero config).
# Set MySQL credentials below if you wish to use MySQL 8.x:
# ==============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=whatchat_db
MYSQL_USER=whatchat_app
MYSQL_PASSWORD=

# SMTP email delivery (optional in local dev, required for production email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=

# Optional media storage configuration (S3 Object Storage)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
